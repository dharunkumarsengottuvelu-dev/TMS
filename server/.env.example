# Environment Configuration
NODE_ENV=development
PORT=5000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/tms_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/tms_db

# Better Auth Configuration
BETTER_AUTH_SECRET=enterprise_super_secret_session_key_min_32_characters_long_12345
BETTER_AUTH_URL=http://localhost:5000

# Client Application URL (For CORS & Secure Cookies)
CLIENT_URL=http://localhost:5173

# Nodemailer / SMTP Configuration
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
MAIL_USER=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM="Enterprise TMS" <no-reply@enterprise.corp>
