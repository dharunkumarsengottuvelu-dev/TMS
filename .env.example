NODE_ENV=development
PORT=5000

# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/tms_enterprise_db?retryWrites=true&w=majority

# Better Auth Secret (min 32 characters)
BETTER_AUTH_SECRET=your_super_secret_session_key_min_32_characters_long
BETTER_AUTH_URL=http://localhost:5000

# Client Portal URL
CLIENT_URL=http://localhost:5173

# Standard SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM="TaskOps Enterprise" <your-email@gmail.com>

# Legacy Mail Configuration Aliases (optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM="TaskOps Enterprise" <your-email@gmail.com>
