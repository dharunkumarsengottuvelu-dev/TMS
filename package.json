{
  "name": "task-management-system",
  "version": "1.0.0",
  "description": "MNC-Level Enterprise Task Management System",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node run-dev.js",
    "server": "npm run dev --workspace=server",
    "client": "npm run dev --workspace=client",
    "seed": "npm run seed --workspace=server",
    "build": "npm run build --workspace=client",
    "lint": "npm run lint --workspace=server && npm run lint --workspace=client"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.2.0",
    "better-auth": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mongodb": "^6.14.0",
    "mongoose": "^8.12.1",
    "nodemailer": "^6.10.0",
    "zod": "^3.24.2"
  }
}
